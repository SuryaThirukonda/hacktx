# Copy to .env and fill in. Keys stay on the Mac backend; never ship them to iOS or the browser bundle.

# --- Decision models -------------------------------------------------------
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
TYPESAFE_API_KEY=
# Local Strands Decider server (strands-decider serve ... --port 8099)
STRANDS_URL=http://127.0.0.1:8099

# --- Narration / voice (optional) ------------------------------------------
GEMINI_API_KEY=
# One or more ElevenLabs accounts: ELEVENLABS_ACCOUNT picks the preferred one, the rest are automatic
# fallbacks (a rejected key is disabled for the session, quota / rate limits are retried after 10 min).
# Free plans cannot use library voices over the API, so a voice the account owns is picked unless set here.
ELEVENLABS_ACCOUNT=1
ELEVENLABS_API_KEY=
ELEVENLABS_API_KEY2=
ELEVENLABS_VOICE_ID=

# --- Access control ---------------------------------------------------------
# When set, /ws/phone, /ws/bridge and control endpoints require ?token=<value> or Authorization: Bearer <value>
OVERWATCH_TOKEN=

# --- Overrides (see config/default.yaml for the full list) ------------------
# OVERWATCH_MODE=SIMULATED          # SIMULATED | LIVE | REPLAY
# OVERWATCH_SCENARIO=demo
# OVERWATCH_DRONE_URL=rtsp://127.0.0.1:8554/drone   # LIVE: any OpenCV-readable URL, or "bridge" for /ws/bridge
# OVERWATCH_DETECTOR=auto           # auto | sim_blob | ultralytics | rfdetr | none
# OVERWATCH_YOLO_WEIGHTS=yolo26n.pt

# --- Incident store (phase 1) ------------------------------------------------
# OVERWATCH_DB=data/overwatch.db   # SQLite incident store; ":memory:" for tests. Evidence and scenes go next to it.
TIGER_DATABASE_URL=            # Tiger Data (TimescaleDB) service URL (CONNECTION_STRING is accepted too): mirrors the event log, telemetry and detections
