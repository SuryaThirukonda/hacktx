{
  "description": "A dispatch (simulator only): launch from the pad, search an area for a described person, track them and\nreport their position relative to the launch point.",
  "properties": {
    "description": {
      "title": "Description",
      "type": "string"
    },
    "phase": {
      "enum": [
        "TAKEOFF",
        "TRANSIT",
        "SEARCH",
        "COVERED",
        "TRACKING",
        "LOST"
      ],
      "title": "Phase",
      "type": "string"
    },
    "pad_xy": {
      "maxItems": 2,
      "minItems": 2,
      "prefixItems": [
        {
          "type": "number"
        },
        {
          "type": "number"
        }
      ],
      "title": "Pad Xy",
      "type": "array"
    },
    "started_ms": {
      "title": "Started Ms",
      "type": "number"
    },
    "leg": {
      "default": 0,
      "title": "Leg",
      "type": "integer"
    },
    "legs": {
      "default": 0,
      "title": "Legs",
      "type": "integer"
    },
    "altitude_m": {
      "default": 28.0,
      "title": "Altitude M",
      "type": "number"
    },
    "matched_track": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Matched Track"
    },
    "matched_by": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Matched By"
    },
    "people_seen": {
      "default": 0,
      "title": "People Seen",
      "type": "integer"
    },
    "rejected": {
      "default": 0,
      "title": "Rejected",
      "type": "integer"
    },
    "last_report": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Last Report"
    }
  },
  "required": [
    "description",
    "phase",
    "pad_xy",
    "started_ms"
  ],
  "title": "DispatchStatus",
  "type": "object"
}