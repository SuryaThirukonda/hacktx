{
  "$defs": {
    "BoundingBox": {
      "properties": {
        "frame": {
          "title": "Frame",
          "type": "string"
        },
        "x0": {
          "title": "X0",
          "type": "number"
        },
        "y0": {
          "title": "Y0",
          "type": "number"
        },
        "x1": {
          "title": "X1",
          "type": "number"
        },
        "y1": {
          "title": "Y1",
          "type": "number"
        }
      },
      "required": [
        "frame",
        "x0",
        "y0",
        "x1",
        "y1"
      ],
      "title": "BoundingBox",
      "type": "object"
    },
    "Observation": {
      "description": "A raw sensor or manual observation. Review decisions are stored separately (``Review``).",
      "properties": {
        "schema_version": {
          "default": "incident-1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "incident_id": {
          "title": "Incident Id",
          "type": "string"
        },
        "sensor_source_id": {
          "title": "Sensor Source Id",
          "type": "string"
        },
        "observed_at": {
          "format": "date-time",
          "title": "Observed At",
          "type": "string"
        },
        "received_at": {
          "format": "date-time",
          "title": "Received At",
          "type": "string"
        },
        "category": {
          "enum": [
            "person",
            "opening",
            "hazard",
            "supply",
            "vehicle",
            "marker",
            "other"
          ],
          "title": "Category",
          "type": "string"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "confidence": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Confidence"
        },
        "detector": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Detector"
        },
        "bounding_box": {
          "anyOf": [
            {
              "$ref": "#/$defs/BoundingBox"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "world_position": {
          "anyOf": [
            {
              "$ref": "#/$defs/Position"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "horizontal_uncertainty_m": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Horizontal Uncertainty M"
        },
        "coordinate_frame": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Coordinate Frame"
        },
        "position_estimation_method": {
          "default": "none",
          "enum": [
            "none",
            "ground_plane",
            "manual",
            "simulation_truth",
            "lidar",
            "anchor"
          ],
          "title": "Position Estimation Method",
          "type": "string"
        },
        "evidence_frame_reference": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Evidence Frame Reference"
        },
        "track_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Track Id"
        },
        "stale_after": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Stale After"
        },
        "provenance": {
          "enum": [
            "live",
            "replay",
            "simulated",
            "manual"
          ],
          "title": "Provenance",
          "type": "string"
        },
        "attributes": {
          "additionalProperties": true,
          "title": "Attributes",
          "type": "object"
        }
      },
      "required": [
        "incident_id",
        "sensor_source_id",
        "observed_at",
        "category",
        "label",
        "provenance"
      ],
      "title": "Observation",
      "type": "object"
    },
    "Position": {
      "properties": {
        "frame": {
          "title": "Frame",
          "type": "string"
        },
        "x": {
          "title": "X",
          "type": "number"
        },
        "y": {
          "title": "Y",
          "type": "number"
        },
        "z": {
          "default": 0.0,
          "title": "Z",
          "type": "number"
        }
      },
      "required": [
        "frame",
        "x",
        "y"
      ],
      "title": "Position",
      "type": "object"
    }
  },
  "description": "An observation merged with its latest review, as the UI shows it.",
  "properties": {
    "observation": {
      "$ref": "#/$defs/Observation"
    },
    "review_status": {
      "default": "pending",
      "enum": [
        "pending",
        "confirmed",
        "rejected"
      ],
      "title": "Review Status",
      "type": "string"
    },
    "reviewer": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Reviewer"
    },
    "review_timestamp": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Review Timestamp"
    },
    "stale": {
      "default": false,
      "title": "Stale",
      "type": "boolean"
    }
  },
  "required": [
    "observation"
  ],
  "title": "ObservationView",
  "type": "object"
}