{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "backend": {
      "root": "backend",
      "framework": "fastapi",
      "entrypoint": "overwatch.main:app"
    },
    "dashboard": {
      "root": "dashboard",
      "framework": "vite"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": { "service": "backend" } },
    { "source": "/ws/(.*)", "destination": { "service": "backend" } },
    { "source": "/streams/(.*)", "destination": { "service": "backend" } },
    { "source": "/health", "destination": { "service": "backend" } },
    { "source": "/dashboard/:path*", "destination": { "service": "dashboard", "path": "/index.html" } },
    { "source": "/responder/:path*", "destination": { "service": "dashboard", "path": "/index.html" } },
    { "source": "/ops/:path*", "destination": { "service": "dashboard", "path": "/index.html" } },
    { "source": "/3d", "destination": { "service": "dashboard", "path": "/index.html" } },
    { "source": "/command", "destination": { "service": "dashboard", "path": "/index.html" } },
    { "source": "/drive", "destination": { "service": "dashboard", "path": "/index.html" } },
    { "source": "/demo", "destination": { "service": "dashboard", "path": "/index.html" } },
    { "source": "/(.*)", "destination": { "service": "dashboard" } }
  ]
}
